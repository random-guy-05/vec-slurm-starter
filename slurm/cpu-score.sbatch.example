#!/usr/bin/env bash
# Copy this file to cpu-score.sbatch and adapt it to local cluster policy.
# Create logs/ before submission; Slurm opens the output path before the job starts.
#SBATCH --job-name=vec-score
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err

set -euo pipefail

# Replace with a module name listed by your cluster, or remove this line when
# activating a container or environment another way.
module load YOUR_PYTHON_MODULE

source .venv/bin/activate
mkdir -p logs
printf 'job=%s host=%s\n' "${SLURM_JOB_ID:-local}" "$(hostname)"
python --version
git rev-parse HEAD > "logs/commit-${SLURM_JOB_ID:-local}.txt" 2>/dev/null || true
python -m pip freeze --local > "logs/packages-${SLURM_JOB_ID:-local}.txt"

if [[ ! -f scripts/run-model.sh ]] || grep -q 'Replace this example with your VEC command' scripts/run-model.sh; then
  echo 'Create and edit scripts/run-model.sh from scripts/run-model.example.sh first.' >&2
  exit 2
fi
bash scripts/run-model.sh
